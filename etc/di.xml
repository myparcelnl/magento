<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Update sales_order_grid table from sales_order table -->
    <virtualType name="Magento\Sales\Model\ResourceModel\Order\Grid" type="Magento\Sales\Model\ResourceModel\Grid">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="track_status" xsi:type="string">sales_order.track_status</item>
                <item name="track_number" xsi:type="string">sales_order.track_number</item>
                <item name="drop_off_day" xsi:type="string">sales_order.drop_off_day</item>
                <item name="myparcel_carrier" xsi:type="string">sales_order.myparcel_carrier</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- API delivery settings -->
    <preference for="MyParcelNL\Magento\Api\DeliveryOptionsInterface"
                type="MyParcelNL\Magento\Model\Checkout\DeliveryOptions" />
    <!-- API shipping methods -->
    <preference for="MyParcelNL\Magento\Api\ShippingMethodsInterface"
                type="MyParcelNL\Magento\Model\Checkout\ShippingMethods" />
    <!-- API package type -->
    <preference for="MyParcelNL\Magento\Api\PackageTypeInterface"
                type="MyParcelNL\Magento\Model\Checkout\PackageType" />
    <!-- API order delivery options -->
    <preference for="MyParcelNL\Magento\Api\OrderDeliveryOptionsInterface"
                type="MyParcelNL\Magento\Model\Rest\OrderDeliveryOptions" />
    <!-- API access token random bytes generator (swap-in seam for tests) -->
    <preference for="MyParcelNL\Magento\Service\ApiAccessToken\RandomBytesGeneratorInterface"
                type="MyParcelNL\Magento\Service\ApiAccessToken\RandomBytesGenerator" />
    <!-- Add print label button in order view -->
    <type name="Magento\Sales\Block\Adminhtml\Order\View">
        <plugin name="mypa-massaction-button" sortOrder="10" type="MyParcelNL\Magento\Plugin\Block\Adminhtml\Order\View"/>
    </type>
    <!-- Add print label button shipment view-->
    <type name="Magento\Shipping\Block\Adminhtml\View">
        <plugin name="mypa-action-download-shipment-label" sortOrder="10" type="MyParcelNL\Magento\Plugin\Block\Adminhtml\Shipment\View"/>
    </type>
    <!-- Avoid default email is sent. With a MyParcel shipment, the mail should be sent only after the barcode exists. -->
    <type name="Magento\Sales\Model\Order\Email\Container\ShipmentIdentity">
        <plugin name="MyParcelNL_Magento_Plugin_Magento_Sales_Model_Order_Email_Container_ShipmentIdentity" sortOrder="10" type="MyParcelNL\Magento\Plugin\Magento\Sales\Model\Order\Email\Container\ShipmentIdentity"/>
    </type>
    <!-- Add field delivery_options to order rest endpoint -->
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="orderInformationUpdate" type="MyParcelNL\Magento\Plugin\Magento\Sales\Api\Data\OrderInformationUpdate" />
    </type>
    <!-- Save address information in checkout -->
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="save-in-quote" type="MyParcelNL\Magento\Model\Checkout\ShippingInformationManagementPlugin" sortOrder="10"/>
    </type>
    <!-- Allow version= parameter in Content-Type for MyParcel REST endpoints (ADR 0011) -->
    <type name="Magento\Framework\Webapi\Rest\Request">
        <plugin name="myparcel-strip-version-parameter"
                type="MyParcelNL\Magento\Plugin\Magento\Framework\Webapi\Rest\Request\StripVersionParameter"
                sortOrder="1"/>
    </type>
    <!-- Intercept exceptions on MyParcel endpoints and format as RFC 9457 Problem Details -->
    <type name="Magento\Framework\Webapi\Rest\Response">
        <plugin name="myparcel-problem-details-error"
                type="MyParcelNL\Magento\Plugin\Magento\Framework\Webapi\Rest\Response\ProblemDetailsError"
                sortOrder="5"/>
    </type>
    <!-- Set versioned Content-Type header on MyParcel REST responses -->
    <type name="Magento\Framework\Webapi\Rest\Response">
        <plugin name="myparcel-version-content-type"
                type="MyParcelNL\Magento\Plugin\Magento\Framework\Webapi\Rest\Response\VersionContentType"
                sortOrder="10"/>
    </type>
    <!-- Prevent double JSON encoding for MyParcel REST endpoints -->
    <type name="Magento\Framework\Webapi\Rest\Response\Renderer\Json">
        <plugin name="myparcel-json-passthrough"
                type="MyParcelNL\Magento\Plugin\Magento\Framework\Webapi\Rest\Response\Renderer\Json"
                sortOrder="10"/>
    </type>

    <!-- Validators consulted when a dynamic setting is saved; each claims its own paths. -->
    <type name="MyParcelNL\Magento\Observer\ConfigChange">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="insurance_amount" xsi:type="object">MyParcelNL\Magento\Model\Settings\Validator\InsuranceAmount</item>
            </argument>
        </arguments>
    </type>
</config>
