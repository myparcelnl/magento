<!-- MyParcel settings have no defaults here: GeneratedDefaults supplies them from Blueprint\Catalogue. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dev>
            <js>
                <minify_exclude>
                    <leaflet>https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.5.1/leaflet.js</leaflet>
                </minify_exclude>
            </js>
        </dev>

        <sales_email>
            <track>
                <enabled>1</enabled>
                <identity>sales</identity>
                <copy_method>bcc</copy_method>
            </track>
        </sales_email>

        <carriers>
            <myparcel>
                <active>1</active>
                <title>MyParcel</title>
                <name>MyParcel</name>
                <shipping_cost>10</shipping_cost>
                <sallowspecific>0</sallowspecific>
                <sort_order>15</sort_order>
                <model>MyParcelNL\Magento\Model\Carrier\Carrier</model>
            </myparcel>
        </carriers>

    </default>
</config>
