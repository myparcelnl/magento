<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Recognizes "Authorization: myparcel <token>" requests as authentication. Runs at sortOrder=5,
        ahead of Magento's native Bearer/token user context (sortOrder=10), so a valid MyParcel token
        resolves to USER_TYPE_INTEGRATION before native auth gets a turn. Non-token callers (admin
        session, native Bearer, guest) fall through unchanged.
    -->
    <type name="Magento\Authorization\Model\CompositeUserContext">
        <arguments>
            <argument name="userContexts" xsi:type="array">
                <item name="myparcelApiAccessTokenUserContext" xsi:type="array">
                    <item name="type" xsi:type="object">MyParcelNL\Magento\Model\Authorization\ApiAccessTokenUserContext</item>
                    <item name="sortOrder" xsi:type="string">5</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!--
        Gate 2 of 3: deny-by-default allow-list of ACL resources reachable by API-token callers.
        Admin / native Bearer / guest callers bypass this gate entirely; only token-authenticated
        callers are filtered against this list. Must stay in sync with etc/integration.xml — the
        regression test Tests/Unit/Service/ScopedResourceRegistryTest enforces this.

        See docs/design/adding-a-token-accessible-rest-endpoint.md (Access matrix).
    -->
    <type name="MyParcelNL\Magento\Service\ScopedResourceRegistry">
        <arguments>
            <argument name="resources" xsi:type="array">
                <item name="sales_actions_view" xsi:type="string">Magento_Sales::actions_view</item>
                <item name="delivery_options_read" xsi:type="string">MyParcelNL_Magento::delivery_options_read</item>
            </argument>
        </arguments>
    </type>

    <!--
        Enforces gate 2: only active when a MyParcel token authenticated the request. Any requested
        ACL resource missing from ScopedResourceRegistry above short-circuits to deny (translated by
        Magento's auth layer into 401/403) before native ACL runs. No-op for non-token callers.
    -->
    <type name="Magento\Framework\Webapi\Authorization">
        <plugin name="myparcel-token-acl-gate"
                type="MyParcelNL\Magento\Plugin\Magento\Webapi\Rest\RequestValidator\MyParcelTokenAclGate"
                sortOrder="10"/>
    </type>

    <!--
        Gate 3 (per-store scope). One allow-listed ACL resource can authorize several services, so
        every service reachable through it needs its own filter — Magento_Sales::actions_view alone
        opens six routes across the three interfaces below. Each plugin constrains getList() to the
        token's permitted stores and turns an out-of-scope single read into a 404.

        Full route -> filter mapping: docs/design/adding-a-token-accessible-rest-endpoint.md
        (Access matrix). Keep it in sync when adding a grant.
    -->
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="myparcel-order-repository-store-filter"
                type="MyParcelNL\Magento\Plugin\Magento\Sales\OrderRepositoryStoreFilter"
                sortOrder="20"/>
    </type>

    <type name="Magento\Sales\Api\OrderItemRepositoryInterface">
        <plugin name="myparcel-order-item-repository-store-filter"
                type="MyParcelNL\Magento\Plugin\Magento\Sales\OrderItemRepositoryStoreFilter"
                sortOrder="20"/>
    </type>

    <type name="Magento\Sales\Api\OrderManagementInterface">
        <plugin name="myparcel-order-management-store-filter"
                type="MyParcelNL\Magento\Plugin\Magento\Sales\OrderManagementStoreFilter"
                sortOrder="20"/>
    </type>
</config>
