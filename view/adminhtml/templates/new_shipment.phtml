<?php
/** @var \MyParcelNL\Magento\Block\Sales\NewShipment $block */
/** @var \Magento\Framework\Escaper $escaper */

$form = $block->getOptionsForm();
?>
<div class="field choice admin__field admin__field-option field-mypa_create_from_observer mypa_create_from_observer-toggle">
    <input
        id="mypa_create_from_observer"
        class="admin__control-checkbox"
        name="mypa_create_from_observer"
        value="1"
        type="checkbox"
        checked="checked" />
    <label class="admin__field-label" for="mypa_create_from_observer">
        <span><?= $form->hasOrderV1() ? __('Export Entire Order') : __('Create MyParcel consignment') ?></span>
    </label>
</div>
<div class="js--mypa-options" style="margin: 10px 0;">
    <?php if (null !== $form->getExportError()): ?>
        <div class="message message-error error">
            <div><?= $escaper->escapeHtml(__('MyParcel refused the last export: %1', $form->getExportError())) ?></div>
        </div>
    <?php endif; ?>
    <dl class="mypa-options-summary" data-mypa-summary>
        <?php foreach ($form->summary() as $label => $value): ?>
            <dt><?= $escaper->escapeHtml($label) ?></dt>
            <dd><?= $escaper->escapeHtml($value) ?></dd>
        <?php endforeach; ?>
    </dl>
    <button type="button" class="action-secondary" data-mypa-change-options>
        <span><?= $escaper->escapeHtml(__('Change MyParcel options')) ?></span>
    </button>
</div>
<script type="text/x-magento-init">
{
    ".page-footer": {
        "myparcelnl_newshipment": {
            "formUrl": "<?= $escaper->escapeJs($block->getOptionsFormUrl()) ?>",
            "saveUrl": "<?= $escaper->escapeJs($block->getOptionsSaveUrl()) ?>",
            "orderId": <?= (int) $block->getOrderId() ?>
        }
    }
}
</script>
