<?php

declare(strict_types=1);

/* @var \MyParcelNL\Magento\Block\System\Config\Form\SettingsButton $block */
/* @var \Magento\Framework\Escaper $escaper */

use Magento\Framework\Exception\LocalizedException;
use MyParcelNL\Magento\Block\System\Config\Form\SettingsButton;

[$scopeName, $scopeId] = $block->getCurrentScope();

$mageInit = [
    'MyParcelNL_Magento/js/account-settings-import' => [
        'ajaxUrl'       => $block->getAjaxUrl(),
        'buttonId'      => SettingsButton::BUTTON_ID,
        'apiKeyFieldId' => $block->getApiKeyFieldId(),
        'scopeName'     => $scopeName,
        'scopeId'       => (int) $scopeId,
        'successLabel'  => (string) __('MyParcel Backoffice settings imported.'),
        'failurePrefix' => (string) __('Importing the MyParcel Backoffice settings failed:'),
        'failureLabel'  => (string) __('Importing the MyParcel Backoffice settings failed. Check the log for details.'),
    ],
];
?>

<div class="myparcel-account-settings-import"
     data-mage-init="<?= $escaper->escapeHtmlAttr(json_encode($mageInit)) ?>">
    <?php
    try {
        echo $block->getButtonHtml();
    } catch (LocalizedException $e) {
        echo $escaper->escapeHtml($e->getMessage());
    }
    ?>

    <div class="message"
         data-role="import-notice"
         role="alert"
         aria-live="polite"
         hidden></div>
</div>
