<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="download_myparcel_label_direct">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">download_myparcel_label_direct</item>
                        <item name="id" xsi:type="string">download_myparcel_label_direct</item>
                        <item name="label" xsi:type="string" translate="true">Print MyParcel labels directly</item>
                        <item name="url" xsi:type="url" path="myparcel/order/CreateAndPrintMyParcelTrack"/>
                        <!-- Without a callback the massaction submits a form at the controller, which
                             now answers JSON. This hands the selection to the same export the modal
                             uses, so the grid keeps it and reloads once. -->
                        <item name="callback" xsi:type="array">
                            <item name="provider" xsi:type="string">myparcel_grid_massaction</item>
                            <item name="target" xsi:type="string">exportSelected</item>
                        </item>
                    </item>
                </argument>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="sales_order_columns">
        <column name="track_status" class="MyParcelNL\Magento\Ui\Component\Listing\Column\ShippingStatus">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Shipping status</item>
                    <item name="sortOrder" xsi:type="number">5</item>
                    <item name="resizeEnabled" xsi:type="boolean">true</item>
                    <item name="resizeDefaultWidth" xsi:type="string">160</item>
                </item>
            </argument>
        </column>
        <column name="track_number" class="MyParcelNL\Magento\Ui\Component\Listing\Column\TrackAndTrace">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Track &amp; Trace</item>
                    <item name="sortOrder" xsi:type="number">6</item>
                    <item name="resizeEnabled" xsi:type="boolean">true</item>
                    <item name="resizeDefaultWidth" xsi:type="string">160</item>
                </item>
            </argument>
        </column>
        <column name="drop_off_day" class="MyParcelNL\Magento\Ui\Component\Listing\Column\DeliveryDate">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="label" xsi:type="string" translate="true">Delivery date</item>
                    <item name="sortOrder" xsi:type="number">7</item>
                    <item name="resizeEnabled" xsi:type="boolean">true</item>
                    <item name="resizeDefaultWidth" xsi:type="string">160</item>
                </item>
            </argument>
        </column>
        <!-- Action column -->
        <actionsColumn name="track_actions" class="MyParcelNL\Magento\Ui\Component\Listing\Column\TrackActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Shipment</item>
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>
